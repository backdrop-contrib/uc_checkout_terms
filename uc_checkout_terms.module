<?php

/**
 * @file
 * Configurable legal documents and checkout acknowledgements for Ubercart.
 */

/**
 * Implements hook_permission().
 */
function uc_checkout_terms_permission() {
  return array('administer uc checkout terms' => array(
    'title' => t('Administer checkout legal documents'),
    'description' => t('Manage public legal documents and their confirmation settings.'),
    'restrict access' => TRUE,
  ));
}

/**
 * Implements hook_menu().
 */
function uc_checkout_terms_menu() {
  $items = array();
  $items['admin/store/settings/checkout-terms'] = array(
    'title' => 'Checkout legal documents',
    'description' => 'Manage legal documents and confirmations.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('uc_checkout_terms_settings_form'),
    'access arguments' => array('administer uc checkout terms'),
    'type' => MENU_NORMAL_ITEM,
  );
  $items['checkout-terms/document/%'] = array(
    'title' => 'Legal document',
    'page callback' => 'uc_checkout_terms_document_page',
    'page arguments' => array(2),
    'access callback' => 'uc_checkout_terms_document_access',
    'access arguments' => array(2),
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Implements hook_config_info().
 */
function uc_checkout_terms_config_info() {
  return array('uc_checkout_terms.settings' => array(
    'label' => t('Checkout legal documents'),
    'group' => t('Configuration'),
  ));
}

/**
 * Returns a new entry. IDs are stable configuration keys, not access tokens.
 */
function uc_checkout_terms_new_entry() {
  return array(
    'enabled' => 1,
    'label' => '',
    'version' => '',
    'source' => 'inline',
    'nid' => 0,
    'body' => array('value' => '', 'format' => filter_fallback_format()),
    'display' => 'inline',
    'confirmation' => 'acknowledge',
    'required' => 1,
    'weight' => 0,
  );
}

/**
 * Reads new settings or converts legacy settings in memory without deleting them.
 */
function uc_checkout_terms_entries() {
  $config = config('uc_checkout_terms.settings');
  $entries = $config->get('entries');
  if (is_array($entries)) {
    return $entries;
  }
  $entries = array();
  foreach (array('agb', 'widerruf') as $key) {
    $nid = (int) $config->get($key . '_nid');
    if (!$nid) {
      continue;
    }
    $entry = uc_checkout_terms_new_entry();
    $entry['source'] = 'node';
    $entry['nid'] = $nid;
    $entry['version'] = (string) $config->get($key . '_version');
    $entry['display'] = 'link';
    $entry['confirmation'] = $key === 'agb' ? 'accept' : 'acknowledge';
    $entry['weight'] = count($entries);
    $label = $key === 'agb' ? trim((string) $config->get('agb_label')) : '';
    if ($label === '') {
      $node = node_load($nid);
      $label = $node ? $node->title : ($key === 'agb' ? 'Terms and conditions' : 'Withdrawal information');
    }
    $entry['label'] = $label;
    $entries[$key] = $entry;
  }
  return $entries;
}

/**
 * Persists the new structure while retaining legacy keys for recovery.
 */
function uc_checkout_terms_migrate() {
  $config = config('uc_checkout_terms.settings');
  if (!is_array($config->get('entries'))) {
    $config->set('entries', uc_checkout_terms_entries());
  }
  $config->set('schema_version', 2)->save();
}

/**
 * Builds the administration form. Inline content uses textarea + text format.
 */
function uc_checkout_terms_settings_form($form, &$form_state) {
  if (!isset($form_state['uct_entries'])) {
    $form_state['uct_entries'] = uc_checkout_terms_entries();
  }
  $form['intro'] = array('#markup' => '<p>' . t('Add legal documents below. All enabled documents apply to every checkout in this release. Archive previous versions before changing a document.') . '</p>');
  $form['entries'] = array(
    '#type' => 'container', '#tree' => TRUE,
    '#prefix' => '<div id="uc-checkout-terms-entries">', '#suffix' => '</div>',
  );
  foreach ($form_state['uct_entries'] as $id => $entry) {
    $entry += uc_checkout_terms_new_entry();
    $node = !empty($entry['nid']) ? node_load($entry['nid']) : FALSE;
    $row = array('#type' => 'fieldset', '#title' => $entry['label'] !== '' ? check_plain($entry['label']) : t('New document'));
    $row['enabled'] = array('#type' => 'checkbox', '#title' => t('Enabled'), '#default_value' => $entry['enabled']);
    $row['label'] = array('#type' => 'textfield', '#title' => t('Document label'), '#default_value' => $entry['label'], '#maxlength' => 150);
    $row['version'] = array('#type' => 'textfield', '#title' => t('Version identifier'), '#default_value' => $entry['version'], '#maxlength' => 100);
    $row['source'] = array('#type' => 'select', '#title' => t('Content source'), '#default_value' => $entry['source'], '#options' => array(
      'inline' => t('Formatted inline text'), 'node' => t('Referenced content'), 'both' => t('Referenced content link and inline text'),
    ));
    // Use an ordinary text input so numeric IDs remain editable without AJAX.
    // The local datalist script explicitly sends the Core autocomplete token.
    $input_id = 'uct-reference-' . preg_replace('/[^a-zA-Z0-9_-]/', '-', $id);
    $list_id = $input_id . '-suggestions';
    $default_node = isset($entry['node_input'])
      ? $entry['node_input']
      : ($node ? $node->title . ' [' . $node->nid . ']' : '');
    $autocomplete_path = 'node/autocomplete';
    $autocomplete_token = function_exists('backdrop_get_autocomplete_token')
      ? backdrop_get_autocomplete_token($autocomplete_path)
      : '';
    $row['node'] = array(
      '#type' => 'textfield',
      '#title' => t('Referenced content'),
      '#id' => $input_id,
      '#default_value' => $default_node,
      '#maxlength' => 1024,
      '#attributes' => array(
        'class' => array('uc-checkout-terms-reference'),
        'list' => $list_id,
        'autocomplete' => 'off',
        'aria-describedby' => $input_id . '-status',
        'data-uct-url' => url($autocomplete_path . '/uct-search-placeholder'),
        'data-uct-token' => $autocomplete_token,
      ),
      '#suffix' => '<datalist id="' . check_plain($list_id) . '"></datalist>' .
        '<span id="' . check_plain($input_id) . '-status" role="status" aria-live="polite"></span>',
      '#description' => t('Enter a node ID or select a title suggestion. Referenced pages open in a new tab and do not require a Body field.'),
      '#attached' => array('js' => array(
        backdrop_get_path('module', 'uc_checkout_terms') . '/js/uc_checkout_terms.reference.js',
      )),
    );
    $row['body'] = array('#type' => 'text_format', '#base_type' => 'textarea', '#title' => t('Inline text'), '#default_value' => $entry['body']['value'], '#format' => $entry['body']['format'], '#rows' => 12,
      '#description' => t('Long formatted text without a summary. The selected text format determines the available editor. This field is used for inline and combined sources.'));
    // Retain the stored legacy value without offering obsolete checkout modes.
    // Checkout now always groups inline text in accordions above confirmations.
    $row['display'] = array('#type' => 'value', '#value' => $entry['display']);
    $row['confirmation'] = array('#type' => 'select', '#title' => t('Confirmation type'), '#default_value' => $entry['confirmation'], '#options' => array(
      'accept' => t('Acceptance'), 'acknowledge' => t('Acknowledgement'), 'notice' => t('Information only; no checkbox'),
    ));
    $row['required'] = array('#type' => 'checkbox', '#title' => t('Require confirmation'), '#default_value' => $entry['required'], '#description' => t('Ignored for information-only documents. Optional checkboxes are not suitable as a substitute for required legal confirmations.'));
    $row['weight'] = array('#type' => 'textfield', '#title' => t('Weight'), '#default_value' => $entry['weight'], '#size' => 6, '#description' => t('Lower numbers appear first.'));
    $row['remove'] = array('#type' => 'submit', '#value' => t('Remove'), '#name' => 'uct_remove_' . $id, '#uct_remove' => $id,
      '#submit' => array('uc_checkout_terms_edit_rows'), '#limit_validation_errors' => array(),
      '#ajax' => array('callback' => 'uc_checkout_terms_rows_ajax', 'wrapper' => 'uc-checkout-terms-entries'));
    $form['entries'][$id] = $row;
  }
  $form['entries']['add'] = array('#type' => 'submit', '#value' => t('Add another document'), '#name' => 'uct_add',
    '#submit' => array('uc_checkout_terms_edit_rows'), '#limit_validation_errors' => array(),
    '#ajax' => array('callback' => 'uc_checkout_terms_rows_ajax', 'wrapper' => 'uc-checkout-terms-entries'));
  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => t('Save configuration'));
  return $form;
}

/**
 * Preserves draft input during add/remove. Nothing is persisted here.
 */
function uc_checkout_terms_edit_rows($form, &$form_state) {
  $input = isset($form_state['input']['entries']) ? $form_state['input']['entries'] : array();
  foreach ($form_state['uct_entries'] as $id => &$entry) {
    if (!isset($input[$id]) || !is_array($input[$id])) {
      continue;
    }
    $values = $input[$id];
    foreach (array('enabled', 'label', 'version', 'source', 'display', 'confirmation', 'required', 'weight') as $key) {
      if (isset($values[$key]) && is_scalar($values[$key])) {
        $entry[$key] = $values[$key];
      }
    }
    foreach (array('enabled', 'required') as $key) {
      $entry[$key] = empty($values[$key]) ? 0 : 1;
    }
    if (isset($values['node']) && is_string($values['node'])) {
      // Retain unresolved draft text across AJAX add/remove operations.
      $entry['node_input'] = $values['node'];
      $entry['nid'] = uc_checkout_terms_parse_nid($values['node']);
    }
    if (isset($values['body']['value'], $values['body']['format']) && is_string($values['body']['value']) && is_string($values['body']['format'])) {
      $entry['body'] = $values['body'];
    }
  }
  unset($entry);
  $trigger = $form_state['triggering_element'];
  if (isset($trigger['#uct_remove'])) {
    $id = $trigger['#uct_remove'];
    unset($form_state['uct_entries'][$id], $form_state['input']['entries'][$id]);
  }
  else {
    $id = 'term_' . substr(hash('sha256', uniqid('', TRUE)), 0, 16);
    $form_state['uct_entries'][$id] = uc_checkout_terms_new_entry();
  }
  $form_state['rebuild'] = TRUE;
}

/**
 * Returns the rebuilt row wrapper.
 */
function uc_checkout_terms_rows_ajax($form, &$form_state) {
  return $form['entries'];
}

/**
 * Parses a core title suggestion or a numeric node ID.
 */
function uc_checkout_terms_parse_nid($input) {
  if (!is_string($input) && !is_int($input)) {
    return 0;
  }
  $input = trim((string) $input);
  if (ctype_digit($input)) {
    return (int) $input;
  }
  return preg_match('/\[([0-9]+)\]\s*$/', $input, $matches) ? (int) $matches[1] : 0;
}

/**
 * Validates settings, including author access to the chosen text format.
 */
function uc_checkout_terms_settings_form_validate($form, &$form_state) {
  unset($form_state['uct_clean_entries']);

  $trigger = isset($form_state['triggering_element'])
    ? $form_state['triggering_element']
    : array();

  // Add/remove buttons may explicitly bypass full validation.
  // A normal submit button has FALSE and must run full validation.
  if (
    isset($trigger['#limit_validation_errors']) &&
    $trigger['#limit_validation_errors'] !== FALSE
  ) {
    return;
  }

  global $user;
  $formats = filter_formats($user);
  $clean = array();
  $values = isset($form_state['values']['entries']) ? $form_state['values']['entries'] : array();
  foreach ($form_state['uct_entries'] as $id => $old) {
    if (!isset($values[$id])) {
      form_set_error('entries', t('The document list is incomplete. Reload the form.'));
      continue;
    }
    $value = $values[$id];
    $entry = uc_checkout_terms_new_entry();
    foreach (array('label', 'version', 'source', 'display', 'confirmation') as $key) {
      $entry[$key] = trim((string) $value[$key]);
    }
    $entry['enabled'] = empty($value['enabled']) ? 0 : 1;
    $entry['required'] = $entry['confirmation'] === 'notice' || empty($value['required']) ? 0 : 1;
    $entry['nid'] = uc_checkout_terms_parse_nid($value['node']);
    if (
      $entry['enabled'] &&
      in_array($entry['source'], array('node', 'both'), TRUE) &&
      $entry['nid'] < 1
    ) {
      form_set_error(
        'entries][' . $id . '][node',
        t('Enter a valid node ID or select a complete title suggestion ending in [ID].')
      );
      continue;
    }
    $entry['body'] = array('value' => (string) $value['body']['value'], 'format' => (string) $value['body']['format']);
    $weight = trim((string) $value['weight']);
    if (!preg_match('/^-?[0-9]+$/', $weight)) {
      form_set_error('entries][' . $id . '][weight', t('Weight must be an integer.'));
    }
    $entry['weight'] = (int) $weight;
    if (!in_array($entry['source'], array('node', 'inline', 'both'), TRUE) || !in_array($entry['display'], array('link', 'inline', 'dialog'), TRUE) || !in_array($entry['confirmation'], array('accept', 'acknowledge', 'notice'), TRUE)) {
      form_set_error('entries][' . $id, t('Invalid document settings.'));
      continue;
    }
    if ($entry['enabled'] && ($entry['label'] === '' || $entry['version'] === '')) {
      form_set_error('entries][' . $id, t('Enabled documents need a label and a version identifier.'));
    }
    $uses_inline = in_array($entry['source'], array('inline', 'both'), TRUE);
    if ($uses_inline && !isset($formats[$entry['body']['format']])) {
      form_set_error('entries][' . $id . '][body', t('You do not have permission to use the selected text format.'));
      continue;
    }
    if ($entry['enabled']) {
      try {
        uc_checkout_terms_snapshot($id, $entry);
      }
      catch (Exception $exception) {
        form_set_error('entries][' . $id, t('Document @label is not available: @reason', array('@label' => $entry['label'], '@reason' => $exception->getMessage())));
      }
    }
    $clean[$id] = $entry;
  }
  $enabled_count = 0;
  foreach ($clean as $entry) {
    $enabled_count += empty($entry['enabled']) ? 0 : 1;
  }
  if (!$enabled_count) {
    form_set_error('entries', t('At least one document must be enabled.'));
  }
  $form_state['uct_clean_entries'] = $clean;
}

/**
 * Saves the repeatable configuration after successful validation.
 */
function uc_checkout_terms_settings_form_submit($form, &$form_state) {
  if (
    !isset($form_state['uct_clean_entries']) ||
    !is_array($form_state['uct_clean_entries']) ||
    !$form_state['uct_clean_entries']
  ) {
    watchdog(
      'uc_checkout_terms',
      'Configuration was not saved because validated document data is missing.',
      array(),
      WATCHDOG_ERROR
    );

    backdrop_set_message(
      t('The configuration could not be saved. Reload the form and try again.'),
      'error'
    );

    return;
  }

  $enabled_count = 0;

  foreach ($form_state['uct_clean_entries'] as $entry) {
    if (!empty($entry['enabled'])) {
      $enabled_count++;
    }
  }

  if (!$enabled_count) {
    backdrop_set_message(
      t('At least one document must be enabled.'),
      'error'
    );

    return;
  }

  config('uc_checkout_terms.settings')
    ->set('entries', $form_state['uct_clean_entries'])
    ->set('schema_version', 2)
    ->save();

  backdrop_set_message(t('The configuration has been saved.'));
}

/**
 * Filters one public text source. Unknown or disabled formats fail closed.
 */
function uc_checkout_terms_filter_text($value, $format, $langcode = '') {
  $formats = filter_formats();
  if ($format === '' || !isset($formats[$format])) {
    throw new Exception(t('The text format is missing or disabled.'));
  }
  if (trim($value) === '') {
    throw new Exception(t('The text is empty.'));
  }
  $html = check_markup($value, $format, $langcode, FALSE);
  if (trim($html) === '') {
    throw new Exception(t('The filtered text is empty.'));
  }
  return array('value' => $value, 'format' => $format, 'language' => $langcode,
    'format_sha256' => hash('sha256', serialize(config('filter.format.' . $format)->get())), 'html' => $html);
}

/**
 * Builds inline snapshots and field-independent reference metadata for audit.
 */
function uc_checkout_terms_snapshot($id, $entry) {
  global $language;
  $langcode = isset($language->langcode) ? $language->langcode : 'en';
  $snapshot = array('id' => $id, 'label' => $entry['label'], 'version' => $entry['version'],
    'confirmation' => $entry['confirmation'], 'required' => (bool) $entry['required'],
    'source' => $entry['source'], 'display' => $entry['display'], 'language' => $langcode,
    'reference_policy' => 'link_only', 'presentation_version' => 2, 'parts' => array());
  if (in_array($entry['source'], array('node', 'both'), TRUE)) {
    $node = node_load((int) $entry['nid']);
    $anonymous = backdrop_anonymous_user();
    if (!$node || empty($node->status) || !node_access('view', $node, $anonymous)) {
      throw new Exception(t('The referenced content must be published and accessible to guests.'));
    }
    $path = 'node/' . (int) $node->nid;
    $snapshot['parts']['node'] = array(
      'type' => 'node_reference', 'snapshot_scope' => 'reference_metadata_only',
      'target_content_archived' => FALSE, 'nid' => (int) $node->nid,
      'vid' => isset($node->vid) ? (int) $node->vid : 0,
      'changed' => isset($node->changed) ? (int) $node->changed : 0,
      'title' => (string) $node->title, 'path' => $path,
      'url' => url($path, array('absolute' => TRUE)),
    );
  }
  if (in_array($entry['source'], array('inline', 'both'), TRUE)) {
    $snapshot['parts']['inline'] = uc_checkout_terms_filter_text($entry['body']['value'], $entry['body']['format'], $langcode);
    $snapshot['parts']['inline']['type'] = 'formatted_text';
    $snapshot['parts']['inline']['snapshot_scope'] = 'source_and_filtered_html';
  }
  if (!$snapshot['parts']) {
    throw new Exception(t('No text source is configured.'));
  }
  $html = array();
  if (isset($snapshot['parts']['node'])) {
    $html[] = '<p>' . uc_checkout_terms_reference_link($snapshot['parts']['node'], $entry['label']) . '</p>';
  }
  if (isset($snapshot['parts']['inline'])) {
    $html[] = '<div class="uc-checkout-terms-text">' . $snapshot['parts']['inline']['html'] . '</div>';
  }
  // Node reference HTML contains a link, not a captured copy of the node page.
  $snapshot['html'] = implode("\n", $html);
  $snapshot['confirmation_text'] = html_entity_decode(
    strip_tags(uc_checkout_terms_confirmation_label($snapshot, FALSE)), ENT_QUOTES, 'UTF-8'
  );
  return $snapshot;
}

/**
 * Builds a safely escaped public node link in a new tab.
 */
function uc_checkout_terms_reference_link($reference, $label) {
  return l($label, $reference['path'], array('attributes' => array(
    'target' => '_blank', 'rel' => 'noopener noreferrer',
  )));
}

/**
 * Builds consistent checkbox wording; only node reference labels are linked.
 */
function uc_checkout_terms_confirmation_label($document, $linked = TRUE) {
  $label = check_plain($document['label']);
  if ($linked && isset($document['parts']['node'])) {
    $label = uc_checkout_terms_reference_link($document['parts']['node'], $document['label']);
  }
  if ($document['confirmation'] === 'accept') {
    return t('!document accepted.', array('!document' => $label));
  }
  if ($document['confirmation'] === 'acknowledge') {
    return t('!document acknowledged.', array('!document' => $label));
  }
  return '';
}

/**
 * Returns a short error using only the configured document label.
 */
function uc_checkout_terms_required_message($document) {
  return t('The field @label is required.', array('@label' => $document['label']));
}
/**
 * Sorts entries deterministically, including equal weights.
 */
function uc_checkout_terms_compare($a, $b) {
  if ($a['weight'] === $b['weight']) {
    return strcmp($a['sort_id'], $b['sort_id']);
  }
  return $a['weight'] < $b['weight'] ? -1 : 1;
}

/**
 * Returns active public documents. No rules or product conditions run yet.
 */
function uc_checkout_terms_documents() {
  $entries = uc_checkout_terms_entries();
  $active = array();
  foreach ($entries as $id => $entry) {
    if (!empty($entry['enabled'])) {
      $entry['sort_id'] = $id;
      $entry['weight'] = (int) $entry['weight'];
      $active[] = $entry;
    }
  }
  if (!$active) {
    throw new Exception(t('No active legal documents are configured.'));
  }
  usort($active, 'uc_checkout_terms_compare');
  $documents = array();
  foreach ($active as $entry) {
    if ($entry['label'] === '' || $entry['version'] === '') {
      throw new Exception(t('Enabled documents need a label and a version identifier.'));
    }
    $id = $entry['sort_id'];
    $documents[$id] = uc_checkout_terms_snapshot($id, $entry);
  }
  return $documents;
}

/**
 * Hashes text, formatting, labels and confirmation requirements.
 */
function uc_checkout_terms_fingerprint($documents) {
  return hash('sha256', serialize($documents));
}

/**
 * Checks public access. Only enabled and valid entries are public.
 */
function uc_checkout_terms_document_access($id) {
  $entries = uc_checkout_terms_entries();
  if (!isset($entries[$id]) || empty($entries[$id]['enabled'])) {
    return FALSE;
  }
  try {
    uc_checkout_terms_snapshot($id, $entries[$id]);
    return TRUE;
  }
  catch (Exception $exception) {
    return FALSE;
  }
}

/**
 * Displays the current configured document, not historical order snapshots.
 */
function uc_checkout_terms_document_page($id) {
  // Avoid storing a current-version document page in the anonymous page cache.
  backdrop_page_is_cacheable(FALSE);
  $entries = uc_checkout_terms_entries();
  if (!isset($entries[$id]) || empty($entries[$id]['enabled'])) {
    return MENU_NOT_FOUND;
  }
  try {
    $document = uc_checkout_terms_snapshot($id, $entries[$id]);
  }
  catch (Exception $exception) {
    return MENU_ACCESS_DENIED;
  }
  backdrop_set_title($document['label']);
  return array('document' => array('#markup' => $document['html']));
}

/**
 * Implements hook_uc_checkout_pane().
 */
function uc_checkout_terms_uc_checkout_pane() {
  return array('checkout_terms' => array(
    'id' => 'checkout_terms', 'title' => t('Legal information'),
    'desc' => t('Display legal documents and collect confirmations.'),
    'callback' => 'uc_checkout_terms_pane', 'weight' => 9,
    'enabled' => TRUE, 'process' => FALSE, 'collapsible' => FALSE,
  ));
}

/**
 * Renders the pane. Confirmation always takes place in the checkout itself.
 */
function uc_checkout_terms_pane($op, $order, $arg2 = NULL) {
  if ($op === 'view') {
    try {
      $documents = uc_checkout_terms_documents();
    }
    catch (Exception $exception) {
      watchdog('uc_checkout_terms', 'Legal documents are unavailable: @reason', array('@reason' => $exception->getMessage()), WATCHDOG_ERROR);
      return array('contents' => array('error' => array('#markup' => '<p class="messages error">' . t('Legal information is currently unavailable. Checkout cannot continue.') . '</p>')));
    }
    $path = backdrop_get_path('module', 'uc_checkout_terms');
    $contents = array(
      '#tree' => TRUE,
      '#attached' => array('css' => array($path . '/css/uc_checkout_terms.css'),
        'js' => array($path . '/js/uc_checkout_terms.accordion.js')),
    );
    $contents['texts'] = array('#type' => 'container', '#weight' => 0,
      '#attributes' => array('class' => array('uc-checkout-terms-accordion')));
    $contents['notices'] = array('#type' => 'container', '#weight' => 1,
      '#attributes' => array('class' => array('uc-checkout-terms-notices')));
    $contents['confirmations'] = array('#type' => 'container', '#weight' => 2,
      '#attributes' => array('class' => array('uc-checkout-terms-confirmations')));
    foreach ($documents as $id => $document) {
      if (isset($document['parts']['inline'])) {
        // Expanded without JavaScript; the behavior collapses these on attach.
        $text = '<details class="uc-checkout-terms-detail" open="open"><summary>' .
          check_plain($document['label']) . '</summary><div class="uc-checkout-terms-text">' .
          $document['parts']['inline']['html'] . '</div></details>';
        $contents['texts'][$id] = array('#markup' => $text);
      }
      if ($document['confirmation'] === 'notice') {
        if (isset($document['parts']['node'])) {
          $contents['notices'][$id] = array('#markup' => '<p>' .
            uc_checkout_terms_reference_link($document['parts']['node'], $document['label']) . '</p>');
        }
        continue;
      }
      $contents['confirmations'][$id] = array(
        '#type' => 'checkbox',
        '#title' => uc_checkout_terms_confirmation_label($document),
        '#required' => $document['required'],
        '#required_message' => uc_checkout_terms_required_message($document),
        '#default_value' => 0,
        // Preserve the existing POST names despite the new visual container.
        '#parents' => array('panes', 'checkout_terms', $id, 'confirmed'),
      );
    }
    $contents['snapshot'] = array('#type' => 'value', '#value' => $documents);
    return array('contents' => $contents);
  }
  if ($op === 'review') {
    $log = !empty($order->data['uc_checkout_terms_log']) ? $order->data['uc_checkout_terms_log'] : array();
    if (!$log) {
      return array();
    }
    $entry = end($log);
    if (!empty($order->data['uc_checkout_terms_latest']) && isset($log[$order->data['uc_checkout_terms_latest']])) {
      $entry = $log[$order->data['uc_checkout_terms_latest']];
    }
    $labels = array();
    foreach ($entry['documents'] as $document) {
      $labels[] = isset($document['label']) ? $document['label'] : (isset($document['title']) ? $document['title'] : '');
    }
    return array(array('title' => t('Legal information'), 'data' => t('Recorded documents: @labels', array('@labels' => implode(', ', $labels)))));
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function uc_checkout_terms_form_uc_cart_checkout_form_alter(&$form, &$form_state) {
  if (!isset($form['#validate'])) {
    $form['#validate'] = array();
  }
  if (!isset($form['#submit'])) {
    $form['#submit'] = array();
  }
  $form['#validate'][] = 'uc_checkout_terms_checkout_validate';
  array_unshift($form['#submit'], 'uc_checkout_terms_checkout_submit');
  // Button-specific handlers replace form-level handlers in the Form API.
  uc_checkout_terms_attach_button_handlers($form);
}

/**
 * Adds handlers to buttons that explicitly override form-level handlers.
 */
function uc_checkout_terms_attach_button_handlers(&$element) {
  if (isset($element['#type']) && $element['#type'] === 'submit') {
    if (array_key_exists('#limit_validation_errors', $element) && $element['#limit_validation_errors'] !== FALSE) {
      return;
    }
    if (isset($element['#validate']) && !in_array('uc_checkout_terms_checkout_validate', $element['#validate'], TRUE)) {
      $element['#validate'][] = 'uc_checkout_terms_checkout_validate';
    }
    if (isset($element['#submit']) && !in_array('uc_checkout_terms_checkout_submit', $element['#submit'], TRUE)) {
      array_unshift($element['#submit'], 'uc_checkout_terms_checkout_submit');
    }
  }
  foreach (element_children($element) as $key) {
    uc_checkout_terms_attach_button_handlers($element[$key]);
  }
}

/**
 * Validates required confirmations against the original server-side snapshot.
 */
function uc_checkout_terms_checkout_validate($form, &$form_state) {
  unset($form_state['uct_validated']);
  $trigger = isset($form_state['triggering_element']) ? $form_state['triggering_element'] : array();
  if (array_key_exists('#limit_validation_errors', $trigger) && $trigger['#limit_validation_errors'] !== FALSE) {
    return;
  }
  $values = isset($form_state['values']['panes']['checkout_terms']) ? $form_state['values']['panes']['checkout_terms'] : array();
  try {
    $current = uc_checkout_terms_documents();
    if (empty($values['snapshot']) || uc_checkout_terms_fingerprint($values['snapshot']) !== uc_checkout_terms_fingerprint($current)) {
      throw new Exception(t('Legal documents have changed. Reload checkout and confirm the current versions.'));
    }
  }
  catch (Exception $exception) {
    form_set_error('panes][checkout_terms', t('Checkout cannot continue: @reason', array('@reason' => $exception->getMessage())));
    return;
  }
  $confirmations = array();
  foreach ($current as $id => $document) {
    $checked = !empty($values[$id]['confirmed']);
    if ($document['confirmation'] !== 'notice' && $document['required'] && !$checked) {
      form_set_error('panes][checkout_terms][' . $id . '][confirmed', uc_checkout_terms_required_message($document));
    }
    $confirmations[$id] = $document['confirmation'] === 'notice' ? NULL : $checked;
  }
  if (empty($form_state['storage']['order']) || !is_object($form_state['storage']['order']) || empty($form_state['storage']['order']->order_id)) {
    form_set_error('panes][checkout_terms', t('The checkout order could not be identified.'));
  }
  if (!form_get_errors()) {
    $form_state['uct_validated'] = array('documents' => $values['snapshot'], 'confirmations' => $confirmations);
  }
}

/**
 * Saves inline/reference snapshots and an internal, non-notifying comment.
 */
function uc_checkout_terms_checkout_submit($form, &$form_state) {
  if (empty($form_state['uct_validated'])) {
    return;
  }
  global $user;
  $order = $form_state['storage']['order'];
  $payload = $form_state['uct_validated'];
  $key = uc_checkout_terms_fingerprint($payload);
  if (!isset($order->data) || !is_array($order->data)) {
    $order->data = array();
  }
  if (!isset($order->data['uc_checkout_terms_log'])) {
    $order->data['uc_checkout_terms_log'] = array();
  }
  if (!empty($order->data['uc_checkout_terms_log'][$key])) {
    $order->data['uc_checkout_terms_latest'] = $key;
    uc_order_save($order);
    return;
  }
  $timestamp = REQUEST_TIME;
  $entry = array('schema_version' => 3, 'order_id' => (int) $order->order_id,
    'uid' => isset($user->uid) ? (int) $user->uid : 0,
    'timestamp' => $timestamp, 'datetime_utc' => gmdate('Y-m-d\TH:i:s\Z', $timestamp),
    'event' => 'checkout_form_submitted', 'documents' => $payload['documents'], 'confirmations' => $payload['confirmations']);
  // Internal audit messages deliberately use English, independent of UI language.
  $lines = array('Legal confirmations recorded.', 'Order: ' . $entry['order_id'], 'Time (UTC): ' . $entry['datetime_utc'], 'User ID: ' . $entry['uid']);
  foreach ($entry['documents'] as $id => $document) {
    $status = $entry['confirmations'][$id];
    $lines[] = $document['label'] . ' [' . $id . '], version ' . $document['version'] . ': ' . ($status === NULL ? 'information provided; no checkbox' : ($status ? 'confirmed' : 'not confirmed (optional)'));
    $lines[] = 'Entry snapshot SHA-256: ' . uc_checkout_terms_fingerprint($document);
    if (isset($document['parts']['node'])) {
      $lines[] = 'Snapshot scope: reference metadata only; linked page content is not archived.';
    }
    if ($document['confirmation_text'] !== '') {
      $lines[] = 'Displayed confirmation: ' . $document['confirmation_text'];
    }
  }
  $lines[] = 'Event: checkout form submitted; this is not proof of payment.';
  $transaction = db_transaction();
  $previous_latest = isset($order->data['uc_checkout_terms_latest']) ? $order->data['uc_checkout_terms_latest'] : NULL;
  try {
    $order->data['uc_checkout_terms_log'][$key] = $entry;
    $order->data['uc_checkout_terms_latest'] = $key;
    uc_order_save($order);
    uc_order_comment_save($order->order_id, $entry['uid'], implode("\n", $lines), 'admin');
  }
  catch (Exception $exception) {
    $transaction->rollback();
    unset($order->data['uc_checkout_terms_log'][$key]);
    if ($previous_latest === NULL) {
      unset($order->data['uc_checkout_terms_latest']);
    }
    else {
      $order->data['uc_checkout_terms_latest'] = $previous_latest;
    }
    watchdog('uc_checkout_terms', 'Could not record legal confirmations for order @order: @reason', array('@order' => $order->order_id, '@reason' => $exception->getMessage()), WATCHDOG_ERROR);
    throw $exception;
  }
  $form_state['storage']['order'] = $order;
}
